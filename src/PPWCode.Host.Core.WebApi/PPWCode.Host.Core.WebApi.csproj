<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- target frameworks -->
    <TargetFrameworks>net6.0;net8.0</TargetFrameworks>

    <!-- Root Namespace -->
    <RootNamespace>PPWCode.Host.Core.WebApi</RootNamespace>

    <!-- nuget package -->
    <IsPackable>true</IsPackable>

    <!-- Stylecop -->
    <CodeAnalysisRuleSet>..\StyleCop.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- PPWCode -->
    <PackageReference Include="PPWCode.API.Core" Version="1.3.0-rc010038" />
    <PackageReference Include="PPWCode.Server.Core" Version="1.4.0-rc010077" />

    <!-- Castle Windsor -->
    <PackageReference Include="Castle.Windsor" Version="5.1.1" />

    <!-- NHibernate -->
    <PackageReference Include="NHibernate" Version="5.5.*" />
  </ItemGroup>

  <!-- Others -->
  <Choose>
    <When Condition=" '$(TargetFramework)' == 'net6.0' ">
      <ItemGroup>
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="6.0.*" />
      </ItemGroup>
    </When>
    <When Condition=" '$(TargetFramework)' == 'net8.0' ">
      <ItemGroup>
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.*" />
      </ItemGroup>
    </When>
  </Choose>

</Project>
